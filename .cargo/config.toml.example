# Cargo ortam değişkenleri — ÖRNEK.
#
# Kullanım:
#   cp .cargo/config.toml.example .cargo/config.toml
#   # sonra anahtarları doldurun
#
# `.cargo/config.toml` bilerek takip DIŞI: sır içeriyor. Bir kez commit'lenip
# herkese açık depoya pushlandı, anahtarlar yenilenmek zorunda kaldı.

[env]
# Ortak Veritabanı ve Mesajlaşma
DATABASE_URL = "postgres://motif:motif@localhost:5433/motif"
NATS_URL = "nats://localhost:4222"

# Gateway Servisi
GATEWAY_KRATOS_URL = "http://localhost:4433"
GATEWAY_KETO_URL = "http://localhost:4466"
GATEWAY_STREAM_URL = "http://localhost:8100"
TOOLBOX_URL = "http://localhost:8116"

# Vision ve Diğer Servisler
STREAM_URL = "http://localhost:8100"

# Stream Servisi
STREAM_STORAGE_ROOT = "./data/stream"

# Teknofest API ve Vektor DB
EVREN_KEY = "BURAYA-KENDI-ANAHTARINIZI-YAZIN"
EVREN_LLM_URL = "https://evren-llmapi.ssyz.org.tr/v1/chat/completions"
QDRANT_URL = "https://evren-vektor.ssyz.org.tr/team40/"
QDRANT_KEY = "BURAYA-KENDI-ANAHTARINIZI-YAZIN"