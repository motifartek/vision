{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stream",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release",
        "-p",
        "stream"
      ],
      "port": 8100,
      "url": "http://localhost:8100"
    },
    {
      "name": "vision",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release",
        "-p",
        "vision"
      ],
      "port": 8110,
      "url": "http://localhost:8110"
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/dashboard",
        "dev"
      ],
      "port": 3001,
      "url": "http://localhost:3001",
      "autoPort": false
    },
    {
      "name": "golden-annotate",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8200",
        "--directory",
        "Utilities/golden-dataset"
      ],
      "port": 8200,
      "url": "http://localhost:8200"
    }
  ]
}
